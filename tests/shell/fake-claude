#!/usr/bin/python3
"""Stand-in for Claude Code ("claude --resume ID"): registers a live session like Claude does
and titles its terminal from $HOME/titles/ID. Not a shell script: Ptyxis names a non-shell
foreground process in the tab title ("… — claude --resume ID"), as it does for Claude."""
import json, os, signal, sys

sid = sys.argv[2]
home = os.environ['HOME']
os.makedirs(f'{home}/.claude/sessions', exist_ok=True)
with open(f'{home}/.claude/sessions/{os.getpid()}.json', 'w') as f:
    json.dump({'pid': os.getpid(), 'sessionId': sid, 'cwd': os.getcwd(), 'kind': 'interactive'}, f)
with open(f'{home}/titles/{sid}') as f:
    print(f'\033]0;{f.read().strip()}\a', end='')
print(f'fake claude {sid}', flush=True)
while True:
    signal.pause()
